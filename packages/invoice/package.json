{
  "name": "@veroao/invoice",
  "version": "0.4.1",
  "description": "Facturas, recibos e notas angolanas em React e Tailwind CSS - com as regras da AGT incluídas",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "fonts",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json && vite build --config preview/vite.config.ts --logLevel warn",
    "dev": "tsc -p tsconfig.build.json --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.scripts.json",
    "templates": "tsx --tsconfig tsconfig.scripts.json scripts/build-templates.tsx",
    "examples": "tsx --tsconfig tsconfig.scripts.json scripts/build-examples.tsx",
    "prepublishOnly": "npm run build && npm test",
    "check:templates": "tsx --tsconfig tsconfig.scripts.json scripts/check-templates.tsx"
  },
  "keywords": [
    "react",
    "tailwind",
    "pdf",
    "factura",
    "invoice",
    "angola",
    "agt",
    "facturação electrónica"
  ],
  "author": "Eterim Prestação de Serviços",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Eterim/vero-template.git",
    "directory": "packages/invoice"
  },
  "homepage": "https://github.com/Eterim/vero-template",
  "peerDependencies": {
    "react": ">=18"
  },
  "dependencies": {
    "@react-pdf/renderer": "^4.9.0",
    "esbuild": "^0.28.2",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@napi-rs/canvas": "^1.0.10",
    "@tailwindcss/vite": "^4.3.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "buffer": "^6.0.3",
    "lucide-react": "^1.53.0",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.2.4",
    "react-dom": "^19.3.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.7",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "veroao-invoice": "./dist/cli/index.js"
  }
}
