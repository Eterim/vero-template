{
  "format": "vero-template",
  "schemaVersion": 2,
  "id": "vero/classico",
  "version": 2,
  "name": "Clássico",
  "author": "vero",
  "template": {
    "version": 2,
    "theme": {
      "colors": {
        "background": "#FFFFFF",
        "foreground": "#111827",
        "muted": "#6B7280",
        "secondary": "#374151",
        "accent": "#000000",
        "line": "#C8CCD1",
        "line-light": "#E5E7EB",
        "surface": "#F3F4F6",
        "zebra": "#F9FAFB"
      },
      "fonts": {
        "body": "Helvetica",
        "display": "Helvetica"
      },
      "styles": {
        "label": {
          "size": 7,
          "weight": 700,
          "uppercase": true,
          "letterSpacing": 0.4,
          "color": "#71717a",
          "marginBottom": 4
        },
        "tableHeader": {
          "size": 7.5,
          "weight": 700,
          "color": "#52525b",
          "paddingX": 6,
          "paddingY": 6,
          "borderBottom": {
            "width": 0.75,
            "color": "#d4d4d8"
          }
        },
        "tableRow": {
          "paddingX": 6,
          "paddingY": 6,
          "borderBottom": {
            "width": 0.5,
            "color": "#e4e4e7"
          }
        },
        "details": {
          "size": 7,
          "color": "#71717a",
          "marginTop": 2
        },
        "body": {
          "color": "foreground"
        }
      }
    },
    "page": {
      "background": "background",
      "marginX": 39.75,
      "marginTop": 9.75,
      "corner": true
    },
    "body": [
      {
        "type": "row",
        "children": [
          {
            "type": "logo",
            "height": 45.75,
            "fallback": "none",
            "style": {
              "flex": 1
            }
          },
          {
            "type": "documentTitle",
            "withCode": true,
            "style": {
              "size": 30,
              "weight": 700,
              "uppercase": true,
              "align": "right",
              "color": "accent"
            }
          }
        ],
        "style": {
          "paddingY": 6,
          "marginBottom": 8.25,
          "justify": "end",
          "borderBottom": {
            "width": 0.938,
            "color": "line"
          }
        }
      },
      {
        "type": "row",
        "children": [
          {
            "type": "party",
            "role": "customer",
            "label": "Contribuinte:",
            "labelStyle": {
              "size": 7.125,
              "weight": 700,
              "color": "secondary",
              "marginBottom": 2.25
            },
            "nameStyle": {
              "size": 10.125,
              "weight": 700
            },
            "style": {
              "size": 7.875,
              "padding": 8.25,
              "gap": 2.25,
              "flex": 4.9,
              "border": {
                "width": 0.75,
                "color": "line"
              }
            }
          },
          {
            "type": "party",
            "role": "issuer",
            "label": "",
            "taxIdLabel": "Nº de Contribuinte:",
            "nameStyle": {
              "size": 10.125,
              "weight": 700
            },
            "style": {
              "size": 7.875,
              "gap": 2.25,
              "flex": 5.1
            }
          }
        ],
        "style": {
          "marginBottom": 14.25,
          "gap": 15,
          "alignItems": "start"
        }
      },
      {
        "type": "documentNumber",
        "prefix": "{{document.title}} - {{document.type}} nº",
        "style": {
          "size": 10.125,
          "weight": 700,
          "uppercase": true
        }
      },
      {
        "type": "row",
        "children": [
          {
            "type": "documentDate",
            "prefix": "Data de emissão:",
            "style": {
              "size": 7.5,
              "color": "muted"
            }
          },
          {
            "type": "atcud",
            "prefix": "ATCUD (Código Único do Documento):",
            "style": {
              "size": 7.5,
              "color": "muted"
            }
          }
        ],
        "style": {
          "marginTop": 3,
          "marginBottom": 12,
          "justify": "between"
        }
      },
      {
        "type": "items",
        "headerStyle": {
          "size": 7.5,
          "weight": 700,
          "color": "secondary",
          "background": "surface"
        },
        "zebra": "zebra",
        "grid": {
          "width": 0.563,
          "color": "line"
        },
        "showCurrency": false,
        "columns": [
          {
            "field": "description",
            "label": "Produto",
            "flex": 3
          },
          {
            "field": "quantity",
            "label": "Qt",
            "flex": 0.8
          },
          {
            "field": "unitPrice",
            "label": "Preço Unit.",
            "flex": 1.5
          },
          {
            "field": "details",
            "label": "Descrição",
            "flex": 2.9,
            "style": {
              "size": 7.125,
              "color": "secondary"
            }
          },
          {
            "field": "taxRate",
            "label": "IVA",
            "flex": 1.1
          },
          {
            "field": "lineTotal",
            "label": "Total",
            "flex": 1
          }
        ],
        "style": {
          "size": 7.875
        }
      },
      {
        "type": "row",
        "children": [
          {
            "type": "stack",
            "children": [],
            "style": {
              "flex": 5.7
            }
          },
          {
            "type": "stack",
            "children": [
              {
                "type": "text",
                "text": "Totais do documento (valores em kwanzas)",
                "style": {
                  "size": 7.875,
                  "weight": 700,
                  "color": "secondary"
                }
              },
              {
                "type": "totals",
                "totalLabel": "Valor total a pagar",
                "byRate": false,
                "showCurrency": false,
                "totalStyle": {
                  "size": 9,
                  "weight": 700
                },
                "rowRule": "line-light",
                "totalBackground": "surface",
                "style": {
                  "size": 7.875,
                  "paddingX": 8.25,
                  "border": {
                    "width": 0.75,
                    "color": "line"
                  }
                }
              }
            ],
            "style": {
              "gap": 5.25,
              "flex": 4.6
            }
          }
        ],
        "style": {
          "marginTop": 12
        }
      },
      {
        "type": "stack",
        "children": [
          {
            "type": "amountInWords",
            "label": "Por extenso:",
            "inline": true,
            "labelStyle": {
              "weight": 700,
              "color": "muted"
            }
          },
          {
            "type": "notes",
            "label": "Notas:",
            "inline": true,
            "labelStyle": {
              "weight": 700,
              "color": "muted"
            }
          }
        ],
        "style": {
          "size": 7.875,
          "marginTop": 24,
          "gap": 6
        }
      },
      {
        "type": "bank",
        "label": "DADOS BANCÁRIOS PARA PAGAMENTO",
        "layout": "table",
        "labelStyle": {
          "size": 7.875,
          "weight": 700,
          "marginBottom": 6
        },
        "headerStyle": {
          "size": 7.125,
          "weight": 700,
          "color": "muted",
          "background": "surface"
        },
        "grid": {
          "width": 0.563,
          "color": "line"
        },
        "style": {
          "size": 7.875,
          "marginTop": 15.75
        }
      },
      {
        "type": "fiscal",
        "parts": [
          "exemptions",
          "legal"
        ],
        "style": {
          "size": 7.125,
          "color": "muted",
          "marginTop": 9.75
        }
      }
    ]
  }
}
