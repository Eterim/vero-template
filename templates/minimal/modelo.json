{
  "format": "vero-template",
  "schemaVersion": 2,
  "id": "vero/minimal",
  "version": 1,
  "name": "Minimal",
  "author": "vero",
  "template": {
    "version": 2,
    "theme": {
      "colors": {
        "background": "#FFFFFF",
        "foreground": "#1C1917",
        "muted": "#78716C",
        "line": "#E7E5E4"
      },
      "fonts": {
        "body": "Inter",
        "display": "Playfair Display"
      },
      "styles": {
        "label": {
          "size": 7,
          "weight": 700,
          "uppercase": true,
          "letterSpacing": 0.4,
          "color": "#71717a",
          "marginBottom": 4
        },
        "tableHeader": {
          "size": 7.5,
          "weight": 700,
          "color": "#52525b",
          "paddingX": 6,
          "paddingY": 6,
          "borderBottom": {
            "width": 0.75,
            "color": "#d4d4d8"
          }
        },
        "tableRow": {
          "paddingX": 6,
          "paddingY": 6,
          "borderBottom": {
            "width": 0.5,
            "color": "#e4e4e7"
          }
        },
        "details": {
          "size": 7,
          "color": "#71717a",
          "marginTop": 2
        },
        "body": {
          "color": "foreground"
        }
      }
    },
    "page": {
      "background": "background",
      "marginX": 56.25,
      "marginTop": 56.25
    },
    "body": [
      {
        "type": "documentTitle",
        "style": {
          "font": "display",
          "size": 34.125
        }
      },
      {
        "type": "row",
        "children": [
          {
            "type": "documentNumber",
            "style": {
              "size": 9,
              "color": "muted"
            }
          },
          {
            "type": "documentDate",
            "style": {
              "size": 9,
              "color": "muted"
            }
          }
        ],
        "style": {
          "marginTop": 6,
          "marginBottom": 36,
          "justify": "between"
        }
      },
      {
        "type": "row",
        "children": [
          {
            "type": "party",
            "role": "issuer",
            "label": "De",
            "labelStyle": {
              "size": 7.125,
              "uppercase": true,
              "letterSpacing": 1.125,
              "color": "muted",
              "marginBottom": 6
            },
            "style": {
              "gap": 2.25,
              "flex": 1
            }
          },
          {
            "type": "party",
            "role": "customer",
            "label": "Para",
            "labelStyle": {
              "size": 7.125,
              "uppercase": true,
              "letterSpacing": 1.125,
              "color": "muted",
              "marginBottom": 6
            },
            "style": {
              "gap": 2.25,
              "flex": 1
            }
          }
        ],
        "style": {
          "marginBottom": 36,
          "gap": 39.75
        }
      },
      {
        "type": "items",
        "headerStyle": {
          "size": 7.125,
          "uppercase": true,
          "letterSpacing": 0.938,
          "color": "muted",
          "paddingY": 8.25,
          "borderBottom": {
            "width": 0.563,
            "color": "foreground"
          }
        },
        "rowStyle": {
          "paddingY": 9.75,
          "borderBottom": {
            "width": 0.563,
            "color": "line"
          }
        },
        "detailsStyle": {
          "size": 7.5,
          "color": "muted",
          "marginTop": 2.25
        }
      },
      {
        "type": "row",
        "children": [
          {
            "type": "stack",
            "children": [
              {
                "type": "amountInWords",
                "labelStyle": {
                  "size": 7.125,
                  "uppercase": true,
                  "letterSpacing": 1.125,
                  "color": "muted",
                  "marginBottom": 6
                }
              },
              {
                "type": "notes",
                "labelStyle": {
                  "size": 7.125,
                  "uppercase": true,
                  "letterSpacing": 1.125,
                  "color": "muted",
                  "marginBottom": 6
                }
              },
              {
                "type": "bank",
                "labelStyle": {
                  "size": 7.125,
                  "uppercase": true,
                  "letterSpacing": 1.125,
                  "color": "muted",
                  "marginBottom": 6
                },
                "headerStyle": {
                  "size": 7.125,
                  "uppercase": true,
                  "letterSpacing": 0.938,
                  "color": "muted",
                  "paddingY": 8.25,
                  "borderBottom": {
                    "width": 0.563,
                    "color": "foreground"
                  }
                }
              }
            ],
            "style": {
              "color": "muted",
              "gap": 12,
              "flex": 1
            }
          },
          {
            "type": "totals",
            "titleStyle": {
              "size": 7.125,
              "uppercase": true,
              "letterSpacing": 1.125,
              "color": "muted",
              "marginBottom": 6
            },
            "totalStyle": {
              "font": "display",
              "size": 22.125
            },
            "style": {
              "flex": 1
            }
          }
        ],
        "style": {
          "marginTop": 27.75,
          "gap": 39.75
        }
      },
      {
        "type": "spacer",
        "size": 30
      },
      {
        "type": "fiscal",
        "style": {
          "size": 7.125,
          "lineHeight": 1.35,
          "color": "muted",
          "paddingY": 14.25,
          "marginTop": 0,
          "gap": 2.25,
          "borderTop": {
            "width": 0.563,
            "color": "line"
          }
        }
      }
    ]
  }
}
