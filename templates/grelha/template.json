{
  "format": "vero-template",
  "schemaVersion": 2,
  "id": "vero/grelha",
  "version": 1,
  "name": "Grelha",
  "author": "vero",
  "template": {
    "version": 2,
    "theme": {
      "colors": {
        "background": "#FFFFFF",
        "foreground": "#111111",
        "muted": "#555555",
        "line": "#111111",
        "head": "#EEEEEE"
      },
      "fonts": {
        "body": "Helvetica",
        "display": "Helvetica"
      },
      "styles": {
        "label": {
          "size": 7,
          "weight": 700,
          "uppercase": true,
          "letterSpacing": 0.4,
          "color": "#71717a",
          "marginBottom": 4
        },
        "tableHeader": {
          "size": 7.5,
          "weight": 700,
          "color": "#52525b",
          "paddingX": 6,
          "paddingY": 6,
          "borderBottom": {
            "width": 0.75,
            "color": "#d4d4d8"
          }
        },
        "tableRow": {
          "paddingX": 6,
          "paddingY": 6,
          "borderBottom": {
            "width": 0.5,
            "color": "#e4e4e7"
          }
        },
        "details": {
          "size": 7,
          "color": "#71717a",
          "marginTop": 2
        },
        "body": {
          "color": "foreground"
        }
      }
    },
    "page": {
      "background": "background",
      "marginX": 33,
      "marginTop": 28.5
    },
    "body": [
      {
        "type": "row",
        "children": [
          {
            "type": "stack",
            "children": [
              {
                "type": "logo",
                "height": 34.5,
                "fallbackStyle": {
                  "size": 13.5,
                  "weight": 700
                }
              }
            ],
            "style": {
              "padding": 6.75,
              "gap": 1.5,
              "flex": 1.3,
              "justify": "center",
              "border": {
                "width": 0.75,
                "color": "line"
              }
            }
          },
          {
            "type": "stack",
            "children": [
              {
                "type": "documentTitle",
                "style": {
                  "size": 12.75,
                  "weight": 700,
                  "uppercase": true,
                  "align": "center"
                }
              },
              {
                "type": "copyLabel",
                "style": {
                  "size": 6.75,
                  "weight": 700,
                  "uppercase": true,
                  "letterSpacing": 1.125
                }
              }
            ],
            "style": {
              "padding": 6.75,
              "gap": 1.5,
              "flex": 1,
              "alignItems": "center",
              "justify": "center",
              "background": "head",
              "border": {
                "width": 0.75,
                "color": "line"
              }
            }
          }
        ],
        "style": {
          "marginBottom": 7.5,
          "gap": 7.5,
          "alignItems": "center"
        }
      },
      {
        "type": "row",
        "children": [
          {
            "type": "party",
            "role": "issuer",
            "label": "Emitente",
            "labelStyle": {
              "size": 6.375,
              "weight": 700,
              "uppercase": true,
              "color": "muted",
              "marginBottom": 2.25
            },
            "nameStyle": {
              "size": 8.25,
              "weight": 700
            },
            "style": {
              "padding": 6.75,
              "gap": 1.5,
              "flex": 1,
              "size": 7.5,
              "border": {
                "width": 0.75,
                "color": "line"
              }
            }
          },
          {
            "type": "party",
            "role": "customer",
            "label": "Cliente",
            "labelStyle": {
              "size": 6.375,
              "weight": 700,
              "uppercase": true,
              "color": "muted",
              "marginBottom": 2.25
            },
            "nameStyle": {
              "size": 8.25,
              "weight": 700
            },
            "style": {
              "padding": 6.75,
              "gap": 1.5,
              "flex": 1,
              "size": 7.5,
              "border": {
                "width": 0.75,
                "color": "line"
              }
            }
          }
        ],
        "style": {
          "marginBottom": 7.5,
          "gap": 7.5
        }
      },
      {
        "type": "row",
        "children": [
          {
            "type": "stack",
            "children": [
              {
                "type": "text",
                "text": "Número",
                "style": {
                  "size": 6.375,
                  "weight": 700,
                  "uppercase": true,
                  "color": "muted",
                  "marginBottom": 2.25
                }
              },
              {
                "type": "documentNumber",
                "style": {
                  "size": 7.875,
                  "weight": 700
                }
              }
            ],
            "style": {
              "padding": 6.75,
              "gap": 1.5,
              "flex": 1,
              "border": {
                "width": 0.75,
                "color": "line"
              }
            }
          },
          {
            "type": "stack",
            "children": [
              {
                "type": "text",
                "text": "Data de emissão",
                "style": {
                  "size": 6.375,
                  "weight": 700,
                  "uppercase": true,
                  "color": "muted",
                  "marginBottom": 2.25
                }
              },
              {
                "type": "documentDate",
                "style": {
                  "size": 7.875
                }
              }
            ],
            "style": {
              "padding": 6.75,
              "gap": 1.5,
              "flex": 1,
              "border": {
                "width": 0.75,
                "color": "line"
              }
            }
          },
          {
            "type": "stack",
            "children": [
              {
                "type": "atcud",
                "prefix": "ATCUD:",
                "style": {
                  "size": 7.875
                }
              }
            ],
            "style": {
              "padding": 6.75,
              "gap": 1.5,
              "flex": 1,
              "justify": "center",
              "border": {
                "width": 0.75,
                "color": "line"
              }
            }
          }
        ],
        "style": {
          "marginBottom": 9,
          "gap": 7.5
        }
      },
      {
        "type": "items",
        "headerStyle": {
          "size": 6.75,
          "weight": 700,
          "uppercase": true,
          "background": "head"
        },
        "detailsStyle": {
          "size": 7.125,
          "color": "muted"
        },
        "grid": {
          "width": 0.75,
          "color": "line"
        },
        "showCurrency": false,
        "style": {
          "size": 7.5
        }
      },
      {
        "type": "row",
        "children": [
          {
            "type": "stack",
            "children": [
              {
                "type": "stack",
                "children": [
                  {
                    "type": "amountInWords",
                    "label": "Por extenso",
                    "labelStyle": {
                      "size": 6.375,
                      "weight": 700,
                      "uppercase": true,
                      "color": "muted",
                      "marginBottom": 2.25
                    },
                    "style": {
                      "size": 7.5
                    }
                  }
                ],
                "style": {
                  "padding": 6.75,
                  "gap": 1.5,
                  "border": {
                    "width": 0.75,
                    "color": "line"
                  }
                }
              },
              {
                "type": "notes",
                "label": "Observações",
                "labelStyle": {
                  "size": 6.375,
                  "weight": 700,
                  "uppercase": true,
                  "color": "muted",
                  "marginBottom": 2.25
                },
                "style": {
                  "padding": 6.75,
                  "gap": 1.5,
                  "size": 7.5,
                  "border": {
                    "width": 0.75,
                    "color": "line"
                  }
                }
              },
              {
                "type": "payment",
                "label": "Pagamento",
                "labelStyle": {
                  "size": 6.375,
                  "weight": 700,
                  "uppercase": true,
                  "color": "muted",
                  "marginBottom": 2.25
                },
                "style": {
                  "padding": 6.75,
                  "gap": 1.5,
                  "size": 7.5,
                  "border": {
                    "width": 0.75,
                    "color": "line"
                  }
                }
              }
            ],
            "style": {
              "gap": 7.5,
              "flex": 1.2
            }
          },
          {
            "type": "totals",
            "totalLabel": "Total (Kz)",
            "showCurrency": false,
            "totalStyle": {
              "size": 9,
              "weight": 700
            },
            "rowRule": "line",
            "totalBackground": "head",
            "style": {
              "flex": 1,
              "size": 7.5,
              "paddingX": 6.75,
              "border": {
                "width": 0.75,
                "color": "line"
              }
            }
          }
        ],
        "style": {
          "marginTop": 9,
          "gap": 7.5,
          "alignItems": "start"
        }
      },
      {
        "type": "bank",
        "label": "Dados bancários",
        "layout": "table",
        "labelStyle": {
          "size": 6.375,
          "weight": 700,
          "uppercase": true,
          "color": "muted",
          "marginBottom": 2.25
        },
        "headerStyle": {
          "size": 6.75,
          "weight": 700,
          "uppercase": true,
          "background": "head"
        },
        "grid": {
          "width": 0.75,
          "color": "line"
        },
        "style": {
          "size": 7.5,
          "marginTop": 9
        }
      },
      {
        "type": "fiscal",
        "parts": [
          "exemptions",
          "legal"
        ],
        "style": {
          "size": 7.125,
          "color": "muted",
          "marginTop": 7.5,
          "gap": 1.5
        }
      }
    ]
  }
}
