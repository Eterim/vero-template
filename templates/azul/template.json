{
  "format": "vero-template",
  "schemaVersion": 2,
  "id": "vero/azul",
  "version": 1,
  "name": "Azul",
  "author": "vero",
  "template": {
    "version": 2,
    "theme": {
      "colors": {
        "background": "#FFFFFF",
        "foreground": "#0F172A",
        "muted": "#64748B",
        "brand": "#1D4ED8",
        "brand-light": "#EFF6FF",
        "line": "#E2E8F0"
      },
      "fonts": {
        "body": "Inter",
        "display": "Inter"
      },
      "styles": {
        "label": {
          "size": 7,
          "weight": 700,
          "uppercase": true,
          "letterSpacing": 0.4,
          "color": "#71717a",
          "marginBottom": 4
        },
        "tableHeader": {
          "size": 7.5,
          "weight": 700,
          "color": "#52525b",
          "paddingX": 6,
          "paddingY": 6,
          "borderBottom": {
            "width": 0.75,
            "color": "#d4d4d8"
          }
        },
        "tableRow": {
          "paddingX": 6,
          "paddingY": 6,
          "borderBottom": {
            "width": 0.5,
            "color": "#e4e4e7"
          }
        },
        "details": {
          "size": 7,
          "color": "#71717a",
          "marginTop": 2
        },
        "body": {
          "color": "foreground"
        }
      }
    },
    "page": {
      "background": "background",
      "marginX": 39.75,
      "marginTop": 26.25
    },
    "body": [
      {
        "type": "row",
        "children": [
          {
            "type": "party",
            "role": "issuer",
            "label": "De",
            "labelStyle": {
              "size": 7.125,
              "weight": 700,
              "uppercase": true,
              "letterSpacing": 0.563,
              "color": "brand",
              "marginBottom": 5.25
            },
            "style": {
              "background": "brand-light",
              "padding": 14.25,
              "gap": 2.25,
              "radius": 9.75,
              "flex": 1
            }
          },
          {
            "type": "party",
            "role": "customer",
            "label": "Para",
            "labelStyle": {
              "size": 7.125,
              "weight": 700,
              "uppercase": true,
              "letterSpacing": 0.563,
              "color": "brand",
              "marginBottom": 5.25
            },
            "style": {
              "background": "brand-light",
              "padding": 14.25,
              "gap": 2.25,
              "radius": 9.75,
              "flex": 1
            }
          },
          {
            "type": "payment",
            "label": "Pagamento",
            "labelStyle": {
              "size": 7.125,
              "weight": 700,
              "uppercase": true,
              "letterSpacing": 0.563,
              "color": "brand",
              "marginBottom": 5.25
            },
            "style": {
              "background": "brand-light",
              "padding": 14.25,
              "gap": 2.25,
              "radius": 9.75,
              "flex": 1
            }
          }
        ],
        "style": {
          "marginBottom": 20.25,
          "gap": 14.25
        }
      },
      {
        "type": "items",
        "headerStyle": {
          "size": 7.5,
          "weight": 700,
          "color": "#ffffff",
          "background": "brand",
          "paddingX": 12,
          "paddingY": 8.25,
          "radius": 6
        },
        "rowStyle": {
          "paddingX": 12,
          "paddingY": 9,
          "borderBottom": {
            "width": 0.563,
            "color": "line"
          }
        },
        "detailsStyle": {
          "size": 7.5,
          "color": "muted",
          "marginTop": 2.25
        }
      },
      {
        "type": "row",
        "children": [
          {
            "type": "stack",
            "children": [
              {
                "type": "amountInWords",
                "labelStyle": {
                  "size": 7.125,
                  "weight": 700,
                  "uppercase": true,
                  "letterSpacing": 0.563,
                  "color": "brand",
                  "marginBottom": 5.25
                },
                "style": {
                  "gap": 2.25
                }
              },
              {
                "type": "notes",
                "labelStyle": {
                  "size": 7.125,
                  "weight": 700,
                  "uppercase": true,
                  "letterSpacing": 0.563,
                  "color": "brand",
                  "marginBottom": 5.25
                },
                "style": {
                  "color": "muted"
                }
              },
              {
                "type": "bank",
                "labelStyle": {
                  "size": 7.125,
                  "weight": 700,
                  "uppercase": true,
                  "letterSpacing": 0.563,
                  "color": "brand",
                  "marginBottom": 5.25
                },
                "headerStyle": {
                  "size": 7.5,
                  "weight": 700,
                  "color": "#ffffff",
                  "background": "brand",
                  "paddingX": 12,
                  "paddingY": 8.25,
                  "radius": 6
                },
                "style": {
                  "gap": 2.25
                }
              }
            ],
            "style": {
              "gap": 9.75,
              "flex": 1
            }
          },
          {
            "type": "totals",
            "titleStyle": {
              "size": 7.125,
              "weight": 700,
              "uppercase": true,
              "letterSpacing": 0.563,
              "color": "brand",
              "marginBottom": 5.25
            },
            "totalStyle": {
              "size": 16.875,
              "weight": 700,
              "color": "brand"
            },
            "style": {
              "background": "brand-light",
              "padding": 14.25,
              "gap": 2.25,
              "radius": 9.75,
              "flex": 1
            }
          }
        ],
        "style": {
          "marginTop": 18,
          "gap": 24
        }
      },
      {
        "type": "fiscal",
        "style": {
          "size": 7.125,
          "lineHeight": 1.35,
          "color": "muted",
          "marginTop": 18,
          "gap": 2.25
        }
      }
    ],
    "top": {
      "style": {
        "background": "brand",
        "paddingX": 39.75,
        "paddingY": 26.25
      },
      "children": [
        {
          "type": "row",
          "children": [
            {
              "type": "logo",
              "height": 36,
              "fallbackStyle": {
                "size": 19.875,
                "weight": 700,
                "color": "#ffffff"
              }
            },
            {
              "type": "stack",
              "children": [
                {
                  "type": "documentTitle",
                  "style": {
                    "size": 18,
                    "weight": 700,
                    "color": "#ffffff"
                  }
                },
                {
                  "type": "documentNumber",
                  "style": {
                    "size": 10.125,
                    "color": "#dbeafe"
                  }
                },
                {
                  "type": "documentDate",
                  "style": {
                    "size": 7.875,
                    "color": "#dbeafe"
                  }
                }
              ],
              "style": {
                "gap": 3,
                "alignItems": "end"
              }
            }
          ],
          "style": {
            "alignItems": "center",
            "justify": "between"
          }
        }
      ]
    }
  }
}
