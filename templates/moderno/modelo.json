{
  "format": "vero-template",
  "schemaVersion": 2,
  "id": "vero/moderno",
  "version": 1,
  "name": "Moderno",
  "author": "vero",
  "template": {
    "version": 2,
    "theme": {
      "colors": {
        "fundo": "#FFFFFF",
        "texto": "#111827",
        "texto-suave": "#6B7280",
        "cinzento": "#374151",
        "destaque": "#0E4C63",
        "linhas": "#C8CCD1",
        "linhas-claras": "#E5E7EB",
        "fundo-cinzento": "#F3F4F6",
        "zebra": "#F9FAFB"
      },
      "fonts": {
        "body": "Helvetica",
        "display": "Helvetica"
      },
      "styles": {
        "rotulo": {
          "size": 7,
          "weight": 700,
          "uppercase": true,
          "letterSpacing": 0.4,
          "color": "#71717a",
          "marginBottom": 4
        },
        "cabecalhoTabela": {
          "size": 7.5,
          "weight": 700,
          "color": "#52525b",
          "paddingX": 6,
          "paddingY": 6,
          "borderBottom": {
            "width": 0.75,
            "color": "#d4d4d8"
          }
        },
        "linhaTabela": {
          "paddingX": 6,
          "paddingY": 6,
          "borderBottom": {
            "width": 0.5,
            "color": "#e4e4e7"
          }
        },
        "detalhe": {
          "size": 7,
          "color": "#71717a",
          "marginTop": 2
        },
        "body": {
          "color": "texto"
        }
      }
    },
    "page": {
      "background": "fundo",
      "marginX": 39.75,
      "marginTop": 9.75,
      "corner": true,
      "cornerColor": "destaque"
    },
    "body": [
      {
        "type": "row",
        "children": [
          {
            "type": "logo",
            "height": 45.75,
            "fallback": "none",
            "style": {
              "flex": 1
            }
          },
          {
            "type": "documentTitle",
            "withCode": true,
            "style": {
              "size": 30,
              "weight": 700,
              "uppercase": true,
              "align": "right",
              "color": "destaque"
            }
          }
        ],
        "style": {
          "paddingY": 6,
          "marginBottom": 8.25,
          "justify": "end",
          "borderBottom": {
            "width": 0.938,
            "color": "linhas"
          }
        }
      },
      {
        "type": "row",
        "children": [
          {
            "type": "party",
            "role": "customer",
            "label": "Contribuinte:",
            "labelStyle": {
              "size": 7.125,
              "weight": 700,
              "color": "cinzento",
              "marginBottom": 2.25
            },
            "nameStyle": {
              "size": 10.125,
              "weight": 700
            },
            "style": {
              "size": 7.875,
              "padding": 8.25,
              "gap": 2.25,
              "flex": 4.9,
              "border": {
                "width": 0.75,
                "color": "linhas"
              }
            }
          },
          {
            "type": "party",
            "role": "issuer",
            "label": "",
            "taxIdLabel": "Nº de Contribuinte:",
            "nameStyle": {
              "size": 10.125,
              "weight": 700
            },
            "style": {
              "size": 7.875,
              "gap": 2.25,
              "flex": 5.1
            }
          }
        ],
        "style": {
          "marginBottom": 14.25,
          "gap": 15,
          "alignItems": "start"
        }
      },
      {
        "type": "documentNumber",
        "prefix": "{{document.title}} - {{document.type}} nº",
        "style": {
          "size": 10.125,
          "weight": 700,
          "uppercase": true
        }
      },
      {
        "type": "row",
        "children": [
          {
            "type": "documentDate",
            "prefix": "Data de emissão:",
            "style": {
              "size": 7.5,
              "color": "texto-suave"
            }
          },
          {
            "type": "atcud",
            "prefix": "ATCUD (Código Único do Documento):",
            "style": {
              "size": 7.5,
              "color": "texto-suave"
            }
          }
        ],
        "style": {
          "marginTop": 3,
          "marginBottom": 12,
          "justify": "between"
        }
      },
      {
        "type": "items",
        "headerStyle": {
          "size": 7.5,
          "weight": 700,
          "color": "cinzento",
          "background": "fundo-cinzento"
        },
        "zebra": "zebra",
        "grid": {
          "width": 0.563,
          "color": "linhas"
        },
        "showCurrency": false,
        "columns": [
          {
            "field": "description",
            "label": "Descrição",
            "flex": 3
          },
          {
            "field": "quantity",
            "label": "Qtd",
            "flex": 0.8
          },
          {
            "field": "unitPrice",
            "label": "Taxa",
            "flex": 1.5
          },
          {
            "field": "details",
            "label": "Descrição",
            "flex": 2.9,
            "style": {
              "size": 7.125,
              "color": "cinzento"
            }
          },
          {
            "field": "taxRate",
            "label": "IVA",
            "flex": 1.1
          },
          {
            "field": "lineTotal",
            "label": "Valor",
            "flex": 1
          }
        ],
        "style": {
          "size": 7.875
        }
      },
      {
        "type": "row",
        "children": [
          {
            "type": "stack",
            "children": [],
            "style": {
              "flex": 5.7
            }
          },
          {
            "type": "stack",
            "children": [
              {
                "type": "text",
                "text": "Totais do documento (valores em kwanzas)",
                "style": {
                  "size": 7.875,
                  "weight": 700,
                  "color": "cinzento"
                }
              },
              {
                "type": "totals",
                "totalLabel": "Valor total a pagar",
                "byRate": false,
                "showCurrency": false,
                "totalStyle": {
                  "size": 9,
                  "weight": 700
                },
                "rowRule": "linhas-claras",
                "totalBackground": "fundo-cinzento",
                "style": {
                  "size": 7.875,
                  "paddingX": 8.25,
                  "border": {
                    "width": 0.75,
                    "color": "linhas"
                  }
                }
              }
            ],
            "style": {
              "gap": 5.25,
              "flex": 4.6
            }
          }
        ],
        "style": {
          "marginTop": 12
        }
      },
      {
        "type": "stack",
        "children": [
          {
            "type": "notes",
            "label": "Instruções de pagamento",
            "inline": true,
            "labelStyle": {
              "weight": 700,
              "color": "texto-suave"
            }
          }
        ],
        "style": {
          "size": 7.875,
          "marginTop": 24,
          "gap": 6
        }
      },
      {
        "type": "bank",
        "label": "Dados bancários",
        "layout": "table",
        "labelStyle": {
          "size": 7.875,
          "weight": 700,
          "marginBottom": 6
        },
        "headerStyle": {
          "size": 7.125,
          "weight": 700,
          "color": "texto-suave",
          "background": "fundo-cinzento"
        },
        "grid": {
          "width": 0.563,
          "color": "linhas"
        },
        "style": {
          "size": 7.875,
          "marginTop": 15.75
        }
      },
      {
        "type": "fiscal",
        "parts": [
          "exemptions",
          "legal"
        ],
        "style": {
          "size": 7.125,
          "color": "texto-suave",
          "marginTop": 9.75
        }
      }
    ],
    "bottom": {
      "height": 48,
      "style": {
        "paddingX": 39.75,
        "paddingY": 9.75,
        "justify": "end"
      },
      "children": [
        {
          "type": "row",
          "children": [
            {
              "type": "fiscal",
              "parts": [
                "certification"
              ]
            },
            {
              "type": "text",
              "text": "{{document.number}}"
            }
          ],
          "style": {
            "size": 7.125,
            "color": "texto-suave",
            "paddingY": 6,
            "justify": "between",
            "borderTop": {
              "width": 0.563,
              "color": "linhas-claras"
            }
          }
        }
      ]
    }
  }
}
