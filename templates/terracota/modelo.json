{
  "format": "vero-template",
  "schemaVersion": 2,
  "id": "vero/terracota",
  "version": 1,
  "name": "Terracota",
  "author": "vero",
  "template": {
    "version": 2,
    "theme": {
      "colors": {
        "background": "#FFFBF5",
        "foreground": "#292524",
        "muted": "#78716C",
        "brand": "#9A3412",
        "sand": "#F3E5D3",
        "line": "#E7D8C6"
      },
      "fonts": {
        "body": "Inter",
        "display": "Playfair Display"
      },
      "styles": {
        "label": {
          "size": 7,
          "weight": 700,
          "uppercase": true,
          "letterSpacing": 0.4,
          "color": "#71717a",
          "marginBottom": 4
        },
        "tableHeader": {
          "size": 7.5,
          "weight": 700,
          "color": "#52525b",
          "paddingX": 6,
          "paddingY": 6,
          "borderBottom": {
            "width": 0.75,
            "color": "#d4d4d8"
          }
        },
        "tableRow": {
          "paddingX": 6,
          "paddingY": 6,
          "borderBottom": {
            "width": 0.5,
            "color": "#e4e4e7"
          }
        },
        "details": {
          "size": 7,
          "color": "#71717a",
          "marginTop": 2
        },
        "body": {
          "color": "foreground"
        }
      }
    },
    "page": {
      "background": "background",
      "marginX": 45.75,
      "marginTop": 44.25
    },
    "body": [
      {
        "type": "row",
        "children": [
          {
            "type": "stack",
            "children": [
              {
                "type": "documentTitle",
                "style": {
                  "font": "display",
                  "size": 28.125
                }
              },
              {
                "type": "documentNumber",
                "style": {
                  "size": 9.375,
                  "color": "muted"
                }
              }
            ],
            "style": {
              "gap": 3.75
            }
          },
          {
            "type": "stack",
            "children": [
              {
                "type": "logo",
                "height": 33.75,
                "fallbackStyle": {
                  "font": "display",
                  "size": 16.125,
                  "color": "brand"
                }
              },
              {
                "type": "documentDate",
                "style": {
                  "size": 8.625,
                  "color": "muted"
                }
              }
            ],
            "style": {
              "gap": 3.75,
              "alignItems": "end"
            }
          }
        ],
        "style": {
          "marginBottom": 27.75,
          "alignItems": "end",
          "justify": "between"
        }
      },
      {
        "type": "row",
        "children": [
          {
            "type": "party",
            "role": "issuer",
            "label": "Emitente",
            "labelStyle": {
              "size": 7.125,
              "weight": 700,
              "uppercase": true,
              "letterSpacing": 0.563,
              "color": "brand",
              "marginBottom": 5.25
            },
            "style": {
              "paddingX": 12,
              "gap": 2.25,
              "flex": 1,
              "borderLeft": {
                "width": 3,
                "color": "brand"
              }
            }
          },
          {
            "type": "party",
            "role": "customer",
            "label": "Cliente",
            "labelStyle": {
              "size": 7.125,
              "weight": 700,
              "uppercase": true,
              "letterSpacing": 0.563,
              "color": "brand",
              "marginBottom": 5.25
            },
            "style": {
              "paddingX": 12,
              "gap": 2.25,
              "flex": 1,
              "borderLeft": {
                "width": 3,
                "color": "brand"
              }
            }
          }
        ],
        "style": {
          "marginBottom": 26.25,
          "gap": 24
        }
      },
      {
        "type": "items",
        "headerStyle": {
          "size": 7.125,
          "weight": 700,
          "uppercase": true,
          "color": "brand",
          "paddingX": 9.75,
          "paddingY": 8.25,
          "borderBottom": {
            "width": 1.5,
            "color": "brand"
          }
        },
        "rowStyle": {
          "paddingX": 9.75,
          "paddingY": 9,
          "borderBottom": {
            "width": 0.563,
            "color": "line"
          }
        },
        "detailsStyle": {
          "size": 7.5,
          "color": "muted",
          "marginTop": 2.25
        }
      },
      {
        "type": "row",
        "children": [
          {
            "type": "stack",
            "children": [
              {
                "type": "amountInWords",
                "labelStyle": {
                  "size": 7.125,
                  "weight": 700,
                  "uppercase": true,
                  "letterSpacing": 0.563,
                  "color": "brand",
                  "marginBottom": 5.25
                }
              },
              {
                "type": "notes",
                "labelStyle": {
                  "size": 7.125,
                  "weight": 700,
                  "uppercase": true,
                  "letterSpacing": 0.563,
                  "color": "brand",
                  "marginBottom": 5.25
                },
                "style": {
                  "color": "muted"
                }
              },
              {
                "type": "payment",
                "labelStyle": {
                  "size": 7.125,
                  "weight": 700,
                  "uppercase": true,
                  "letterSpacing": 0.563,
                  "color": "brand",
                  "marginBottom": 5.25
                }
              },
              {
                "type": "bank",
                "labelStyle": {
                  "size": 7.125,
                  "weight": 700,
                  "uppercase": true,
                  "letterSpacing": 0.563,
                  "color": "brand",
                  "marginBottom": 5.25
                },
                "headerStyle": {
                  "size": 7.125,
                  "weight": 700,
                  "uppercase": true,
                  "color": "brand",
                  "paddingX": 9.75,
                  "paddingY": 8.25,
                  "borderBottom": {
                    "width": 1.5,
                    "color": "brand"
                  }
                }
              }
            ],
            "style": {
              "gap": 9.75,
              "flex": 1
            }
          },
          {
            "type": "totals",
            "titleStyle": {
              "size": 7.125,
              "weight": 700,
              "uppercase": true,
              "letterSpacing": 0.563,
              "color": "brand",
              "marginBottom": 5.25
            },
            "totalStyle": {
              "size": 16.875,
              "weight": 700,
              "color": "brand"
            },
            "style": {
              "background": "sand",
              "padding": 15.75,
              "radius": 3.75,
              "flex": 1
            }
          }
        ],
        "style": {
          "marginTop": 20.25,
          "gap": 27.75
        }
      },
      {
        "type": "fiscal",
        "style": {
          "size": 7.125,
          "lineHeight": 1.35,
          "color": "muted",
          "marginTop": 18,
          "gap": 2.25
        }
      }
    ],
    "bottom": {
      "height": 33.75,
      "style": {
        "background": "brand",
        "paddingX": 45.75,
        "justify": "center"
      },
      "children": [
        {
          "type": "row",
          "children": [
            {
              "type": "text",
              "text": "{{org.name}} · {{org.website}}",
              "style": {
                "size": 7.5,
                "color": "#ffffff"
              }
            },
            {
              "type": "pageNumber",
              "style": {
                "size": 7.5,
                "weight": 700,
                "color": "#ffffff"
              }
            }
          ],
          "style": {
            "justify": "between"
          }
        }
      ]
    }
  }
}
