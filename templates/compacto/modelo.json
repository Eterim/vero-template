{
  "format": "vero-template",
  "schemaVersion": 2,
  "id": "vero/compacto",
  "version": 1,
  "name": "Compacto",
  "author": "vero",
  "template": {
    "version": 2,
    "theme": {
      "colors": {
        "fundo": "#FFFFFF",
        "texto": "#000000",
        "texto-suave": "#525252",
        "cinzento-claro": "#F5F5F5",
        "linhas": "#D4D4D4"
      },
      "fonts": {
        "body": "Helvetica",
        "display": "Helvetica"
      },
      "styles": {
        "rotulo": {
          "size": 7,
          "weight": 700,
          "uppercase": true,
          "letterSpacing": 0.4,
          "color": "#71717a",
          "marginBottom": 4
        },
        "cabecalhoTabela": {
          "size": 7.5,
          "weight": 700,
          "color": "#52525b",
          "paddingX": 6,
          "paddingY": 6,
          "borderBottom": {
            "width": 0.75,
            "color": "#d4d4d8"
          }
        },
        "linhaTabela": {
          "paddingX": 6,
          "paddingY": 6,
          "borderBottom": {
            "width": 0.5,
            "color": "#e4e4e7"
          }
        },
        "detalhe": {
          "size": 7,
          "color": "#71717a",
          "marginTop": 2
        },
        "body": {
          "color": "texto"
        }
      }
    },
    "page": {
      "background": "fundo",
      "marginX": 27.75,
      "marginTop": 26.25
    },
    "body": [
      {
        "type": "row",
        "children": [
          {
            "type": "logo",
            "height": 27.75,
            "fallbackStyle": {
              "size": 12,
              "weight": 700
            }
          },
          {
            "type": "stack",
            "children": [
              {
                "type": "documentTitle",
                "style": {
                  "size": 13.125,
                  "weight": 700,
                  "uppercase": true
                }
              },
              {
                "type": "documentNumber",
                "style": {
                  "size": 8.625,
                  "weight": 700
                }
              },
              {
                "type": "documentDate",
                "style": {
                  "size": 7.5
                }
              }
            ],
            "style": {
              "gap": 0.75,
              "alignItems": "end"
            }
          }
        ],
        "style": {
          "paddingY": 6,
          "marginBottom": 9.75,
          "alignItems": "start",
          "justify": "between",
          "borderBottom": {
            "width": 0.938,
            "color": "texto"
          }
        }
      },
      {
        "type": "row",
        "children": [
          {
            "type": "party",
            "role": "issuer",
            "label": "Emitente",
            "labelStyle": {
              "size": 6.375,
              "weight": 700,
              "uppercase": true,
              "color": "texto-suave",
              "marginBottom": 2.25
            },
            "style": {
              "flex": 1
            }
          },
          {
            "type": "party",
            "role": "customer",
            "label": "Cliente",
            "labelStyle": {
              "size": 6.375,
              "weight": 700,
              "uppercase": true,
              "color": "texto-suave",
              "marginBottom": 2.25
            },
            "style": {
              "flex": 1
            }
          },
          {
            "type": "payment",
            "label": "Pagamento",
            "labelStyle": {
              "size": 6.375,
              "weight": 700,
              "uppercase": true,
              "color": "texto-suave",
              "marginBottom": 2.25
            },
            "style": {
              "flex": 1
            }
          }
        ],
        "style": {
          "size": 7.5,
          "marginBottom": 9.75,
          "gap": 12
        }
      },
      {
        "type": "items",
        "headerStyle": {
          "size": 6.375,
          "weight": 700,
          "uppercase": true,
          "background": "cinzento-claro",
          "paddingX": 3.75,
          "paddingY": 3.75
        },
        "rowStyle": {
          "paddingX": 3.75,
          "paddingY": 3.75,
          "borderBottom": {
            "width": 0.375,
            "color": "linhas"
          }
        },
        "detailsStyle": {
          "size": 6.375,
          "color": "texto-suave"
        },
        "style": {
          "size": 7.5
        }
      },
      {
        "type": "row",
        "children": [
          {
            "type": "stack",
            "children": [
              {
                "type": "amountInWords",
                "labelStyle": {
                  "size": 6.375,
                  "weight": 700,
                  "uppercase": true,
                  "color": "texto-suave",
                  "marginBottom": 2.25
                }
              },
              {
                "type": "notes",
                "labelStyle": {
                  "size": 6.375,
                  "weight": 700,
                  "uppercase": true,
                  "color": "texto-suave",
                  "marginBottom": 2.25
                }
              },
              {
                "type": "bank",
                "labelStyle": {
                  "size": 6.375,
                  "weight": 700,
                  "uppercase": true,
                  "color": "texto-suave",
                  "marginBottom": 2.25
                },
                "headerStyle": {
                  "size": 6.375,
                  "weight": 700,
                  "uppercase": true,
                  "background": "cinzento-claro",
                  "paddingX": 3.75,
                  "paddingY": 3.75
                }
              }
            ],
            "style": {
              "gap": 6,
              "flex": 1
            }
          },
          {
            "type": "totals",
            "titleStyle": {
              "size": 6.375,
              "weight": 700,
              "uppercase": true,
              "color": "texto-suave",
              "marginBottom": 2.25
            },
            "totalStyle": {
              "size": 10.875,
              "weight": 700
            },
            "style": {
              "flex": 1
            }
          }
        ],
        "style": {
          "size": 7.5,
          "marginTop": 8.25,
          "gap": 15.75
        }
      },
      {
        "type": "fiscal",
        "style": {
          "size": 7.125,
          "lineHeight": 1.35,
          "color": "texto-suave",
          "marginTop": 9.75,
          "gap": 2.25
        }
      }
    ]
  }
}
