{
  "format": "vero-template",
  "schemaVersion": 2,
  "id": "vero/limpo",
  "version": 1,
  "name": "Limpo",
  "author": "vero",
  "template": {
    "version": 2,
    "theme": {
      "colors": {
        "background": "#FFFFFF",
        "foreground": "#18181B",
        "muted": "#71717A",
        "accent": "#18181B",
        "surface": "#F4F4F5",
        "line": "#E4E4E7"
      },
      "fonts": {
        "body": "Inter",
        "display": "Inter"
      },
      "styles": {
        "label": {
          "size": 7,
          "weight": 700,
          "uppercase": true,
          "letterSpacing": 0.4,
          "color": "#71717a",
          "marginBottom": 4
        },
        "tableHeader": {
          "size": 7.5,
          "weight": 700,
          "color": "#52525b",
          "paddingX": 6,
          "paddingY": 6,
          "borderBottom": {
            "width": 0.75,
            "color": "#d4d4d8"
          }
        },
        "tableRow": {
          "paddingX": 6,
          "paddingY": 6,
          "borderBottom": {
            "width": 0.5,
            "color": "#e4e4e7"
          }
        },
        "details": {
          "size": 7,
          "color": "#71717a",
          "marginTop": 2
        },
        "body": {
          "color": "foreground"
        }
      }
    },
    "page": {
      "background": "background",
      "marginX": 44.25,
      "marginTop": 39.75
    },
    "body": [
      {
        "type": "row",
        "children": [
          {
            "type": "logo",
            "height": 36,
            "fallbackStyle": {
              "size": 18,
              "weight": 700
            }
          },
          {
            "type": "stack",
            "children": [
              {
                "type": "documentTitle",
                "style": {
                  "size": 19.875,
                  "weight": 700
                }
              },
              {
                "type": "documentNumber",
                "style": {
                  "size": 10.125
                }
              },
              {
                "type": "documentDate",
                "style": {
                  "size": 8.625,
                  "color": "muted"
                }
              }
            ],
            "style": {
              "gap": 3,
              "alignItems": "end"
            }
          }
        ],
        "style": {
          "marginBottom": 27.75,
          "alignItems": "start",
          "justify": "between"
        }
      },
      {
        "type": "row",
        "children": [
          {
            "type": "party",
            "role": "issuer",
            "label": "De",
            "labelStyle": {
              "size": 7.125,
              "weight": 700,
              "uppercase": true,
              "letterSpacing": 0.563,
              "color": "muted",
              "marginBottom": 5.25
            },
            "style": {
              "gap": 2.25,
              "flex": 1
            }
          },
          {
            "type": "party",
            "role": "customer",
            "label": "Para",
            "labelStyle": {
              "size": 7.125,
              "weight": 700,
              "uppercase": true,
              "letterSpacing": 0.563,
              "color": "muted",
              "marginBottom": 5.25
            },
            "style": {
              "background": "surface",
              "padding": 12,
              "gap": 2.25,
              "radius": 6,
              "flex": 1
            }
          }
        ],
        "style": {
          "marginBottom": 24,
          "gap": 20.25
        }
      },
      {
        "type": "items",
        "headerStyle": {
          "size": 7.125,
          "weight": 700,
          "uppercase": true,
          "color": "muted",
          "paddingX": 8.25,
          "paddingY": 6.75,
          "borderBottom": {
            "width": 0.938,
            "color": "foreground"
          }
        },
        "rowStyle": {
          "paddingX": 8.25,
          "paddingY": 8.25,
          "borderBottom": {
            "width": 0.563,
            "color": "line"
          }
        },
        "detailsStyle": {
          "size": 7.5,
          "color": "muted",
          "marginTop": 2.25
        }
      },
      {
        "type": "row",
        "children": [
          {
            "type": "stack",
            "children": [
              {
                "type": "amountInWords",
                "labelStyle": {
                  "size": 7.125,
                  "weight": 700,
                  "uppercase": true,
                  "letterSpacing": 0.563,
                  "color": "muted",
                  "marginBottom": 5.25
                },
                "style": {
                  "gap": 2.25
                }
              },
              {
                "type": "notes",
                "labelStyle": {
                  "size": 7.125,
                  "weight": 700,
                  "uppercase": true,
                  "letterSpacing": 0.563,
                  "color": "muted",
                  "marginBottom": 5.25
                },
                "style": {
                  "color": "muted"
                }
              },
              {
                "type": "payment",
                "labelStyle": {
                  "size": 7.125,
                  "weight": 700,
                  "uppercase": true,
                  "letterSpacing": 0.563,
                  "color": "muted",
                  "marginBottom": 5.25
                },
                "style": {
                  "gap": 2.25
                }
              },
              {
                "type": "bank",
                "labelStyle": {
                  "size": 7.125,
                  "weight": 700,
                  "uppercase": true,
                  "letterSpacing": 0.563,
                  "color": "muted",
                  "marginBottom": 5.25
                },
                "headerStyle": {
                  "size": 7.125,
                  "weight": 700,
                  "uppercase": true,
                  "color": "muted",
                  "paddingX": 8.25,
                  "paddingY": 6.75,
                  "borderBottom": {
                    "width": 0.938,
                    "color": "foreground"
                  }
                },
                "style": {
                  "gap": 2.25
                }
              }
            ],
            "style": {
              "gap": 12,
              "flex": 1
            }
          },
          {
            "type": "totals",
            "titleStyle": {
              "size": 7.125,
              "weight": 700,
              "uppercase": true,
              "letterSpacing": 0.563,
              "color": "muted",
              "marginBottom": 5.25
            },
            "totalStyle": {
              "size": 15,
              "weight": 700
            },
            "style": {
              "flex": 1
            }
          }
        ],
        "style": {
          "marginTop": 20.25,
          "gap": 27.75
        }
      },
      {
        "type": "spacer",
        "size": 24
      },
      {
        "type": "row",
        "children": [
          {
            "type": "fiscal",
            "style": {
              "size": 7.125,
              "color": "muted",
              "gap": 2.25,
              "flex": 1
            }
          }
        ],
        "style": {
          "paddingY": 12,
          "gap": 12,
          "alignItems": "end",
          "borderTop": {
            "width": 0.563,
            "color": "line"
          }
        }
      }
    ]
  }
}
