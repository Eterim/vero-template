{
  "format": "vero-template",
  "schemaVersion": 2,
  "id": "vero/bloco",
  "version": 1,
  "name": "Bloco",
  "author": "vero",
  "template": {
    "version": 2,
    "theme": {
      "colors": {
        "background": "#FFFFFF",
        "foreground": "#0A0A0A",
        "muted": "#737373",
        "accent": "#2563EB",
        "dark": "#0A0A0A",
        "line": "#E5E5E5",
        "soft": "#F5F5F5"
      },
      "fonts": {
        "body": "Inter",
        "display": "Inter"
      },
      "styles": {
        "label": {
          "size": 7,
          "weight": 700,
          "uppercase": true,
          "letterSpacing": 0.4,
          "color": "#71717a",
          "marginBottom": 4
        },
        "tableHeader": {
          "size": 7.5,
          "weight": 700,
          "color": "#52525b",
          "paddingX": 6,
          "paddingY": 6,
          "borderBottom": {
            "width": 0.75,
            "color": "#d4d4d8"
          }
        },
        "tableRow": {
          "paddingX": 6,
          "paddingY": 6,
          "borderBottom": {
            "width": 0.5,
            "color": "#e4e4e7"
          }
        },
        "details": {
          "size": 7,
          "color": "#71717a",
          "marginTop": 2
        },
        "body": {
          "color": "foreground"
        }
      }
    },
    "page": {
      "background": "background",
      "marginX": 37.5,
      "marginTop": 33
    },
    "body": [
      {
        "type": "row",
        "children": [
          {
            "type": "logo",
            "height": 28.5,
            "fallbackStyle": {
              "size": 12.75,
              "weight": 700
            }
          },
          {
            "type": "row",
            "children": [
              {
                "type": "statusBadge",
                "style": {
                  "size": 6.75,
                  "weight": 700,
                  "uppercase": true,
                  "color": "#FFFFFF",
                  "background": "accent",
                  "paddingX": 6,
                  "paddingY": 3,
                  "radius": 2.25
                }
              },
              {
                "type": "copyLabel",
                "style": {
                  "size": 6.75,
                  "weight": 700,
                  "uppercase": true,
                  "letterSpacing": 1.125,
                  "paddingX": 6,
                  "paddingY": 3,
                  "radius": 2.25,
                  "border": {
                    "width": 0.75,
                    "color": "dark"
                  }
                }
              }
            ],
            "style": {
              "gap": 7.5,
              "alignItems": "center"
            }
          }
        ],
        "style": {
          "marginBottom": 6,
          "alignItems": "center",
          "justify": "between"
        }
      },
      {
        "type": "stack",
        "children": [
          {
            "type": "documentTitle",
            "style": {
              "size": 9.75,
              "weight": 700,
              "uppercase": true,
              "letterSpacing": 0.75,
              "color": "accent"
            }
          },
          {
            "type": "documentNumber",
            "style": {
              "size": 22.5,
              "weight": 700
            }
          },
          {
            "type": "documentDate",
            "prefix": "Emitida em",
            "style": {
              "size": 7.875,
              "color": "muted"
            }
          }
        ],
        "style": {
          "marginBottom": 18,
          "gap": 1.5
        }
      },
      {
        "type": "row",
        "children": [
          {
            "type": "party",
            "role": "issuer",
            "label": "De",
            "labelStyle": {
              "size": 6.75,
              "weight": 700,
              "uppercase": true,
              "letterSpacing": 0.75,
              "color": "muted",
              "marginBottom": 3
            },
            "nameStyle": {
              "size": 8.625,
              "weight": 700
            },
            "style": {
              "flex": 1,
              "radius": 4.5,
              "padding": 10.5,
              "gap": 1.5,
              "size": 7.5,
              "border": {
                "width": 0.75,
                "color": "line"
              }
            }
          },
          {
            "type": "party",
            "role": "customer",
            "label": "Para",
            "labelStyle": {
              "size": 6.75,
              "weight": 700,
              "uppercase": true,
              "letterSpacing": 0.75,
              "color": "muted",
              "marginBottom": 3
            },
            "nameStyle": {
              "size": 8.625,
              "weight": 700
            },
            "style": {
              "flex": 1,
              "radius": 4.5,
              "padding": 10.5,
              "gap": 1.5,
              "size": 7.5,
              "border": {
                "width": 0.75,
                "color": "line"
              }
            }
          }
        ],
        "style": {
          "marginBottom": 19.5,
          "gap": 10.5
        }
      },
      {
        "type": "items",
        "headerStyle": {
          "size": 6.75,
          "weight": 700,
          "uppercase": true,
          "color": "muted",
          "background": "soft",
          "paddingX": 7.5,
          "paddingY": 6
        },
        "rowStyle": {
          "paddingX": 7.5,
          "paddingY": 6.75,
          "borderBottom": {
            "width": 0.75,
            "color": "line"
          }
        },
        "detailsStyle": {
          "size": 7.125,
          "color": "muted",
          "marginTop": 1.5
        },
        "style": {
          "size": 7.5
        }
      },
      {
        "type": "row",
        "children": [
          {
            "type": "stack",
            "children": [
              {
                "type": "amountInWords",
                "labelStyle": {
                  "size": 6.75,
                  "weight": 700,
                  "uppercase": true,
                  "letterSpacing": 0.75,
                  "color": "muted",
                  "marginBottom": 3
                },
                "style": {
                  "size": 7.5
                }
              },
              {
                "type": "notes",
                "labelStyle": {
                  "size": 6.75,
                  "weight": 700,
                  "uppercase": true,
                  "letterSpacing": 0.75,
                  "color": "muted",
                  "marginBottom": 3
                },
                "style": {
                  "size": 7.5,
                  "color": "muted"
                }
              },
              {
                "type": "payment",
                "labelStyle": {
                  "size": 6.75,
                  "weight": 700,
                  "uppercase": true,
                  "letterSpacing": 0.75,
                  "color": "muted",
                  "marginBottom": 3
                },
                "style": {
                  "size": 7.5
                }
              },
              {
                "type": "bank",
                "labelStyle": {
                  "size": 6.75,
                  "weight": 700,
                  "uppercase": true,
                  "letterSpacing": 0.75,
                  "color": "muted",
                  "marginBottom": 3
                },
                "style": {
                  "size": 7.5
                }
              }
            ],
            "style": {
              "gap": 9,
              "flex": 1
            }
          },
          {
            "type": "totals",
            "totalStyle": {
              "size": 16.5,
              "weight": 700
            },
            "style": {
              "flex": 1,
              "size": 7.5,
              "background": "dark",
              "color": "#FFFFFF",
              "radius": 4.5,
              "padding": 13.5
            }
          }
        ],
        "style": {
          "marginTop": 18,
          "gap": 22.5,
          "alignItems": "start"
        }
      },
      {
        "type": "fiscal",
        "style": {
          "size": 7.125,
          "lineHeight": 1.35,
          "color": "muted",
          "marginTop": 16.5,
          "gap": 2.25
        }
      },
      {
        "type": "row",
        "children": [
          {
            "type": "text",
            "text": "{{org.name}} · {{org.website}}",
            "style": {
              "size": 6.75,
              "color": "muted"
            }
          },
          {
            "type": "pageNumber",
            "style": {
              "size": 6.75,
              "color": "muted"
            }
          }
        ],
        "style": {
          "marginTop": 9,
          "justify": "between"
        }
      }
    ]
  }
}
