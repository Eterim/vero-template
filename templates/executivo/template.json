{
  "format": "vero-template",
  "schemaVersion": 2,
  "id": "vero/executivo",
  "version": 1,
  "name": "Executivo",
  "author": "vero",
  "template": {
    "version": 2,
    "theme": {
      "colors": {
        "background": "#FFFFFF",
        "foreground": "#18181B",
        "muted": "#71717A",
        "ink": "#18181B",
        "gold": "#B08D57",
        "line": "#E4E4E7",
        "soft": "#FAFAF9"
      },
      "fonts": {
        "body": "Inter",
        "display": "Playfair Display"
      },
      "styles": {
        "label": {
          "size": 7,
          "weight": 700,
          "uppercase": true,
          "letterSpacing": 0.4,
          "color": "#71717a",
          "marginBottom": 4
        },
        "tableHeader": {
          "size": 7.5,
          "weight": 700,
          "color": "#52525b",
          "paddingX": 6,
          "paddingY": 6,
          "borderBottom": {
            "width": 0.75,
            "color": "#d4d4d8"
          }
        },
        "tableRow": {
          "paddingX": 6,
          "paddingY": 6,
          "borderBottom": {
            "width": 0.5,
            "color": "#e4e4e7"
          }
        },
        "details": {
          "size": 7,
          "color": "#71717a",
          "marginTop": 2
        },
        "body": {
          "color": "foreground"
        }
      }
    },
    "page": {
      "background": "background",
      "marginX": 40.5,
      "marginTop": 22.5
    },
    "body": [
      {
        "type": "row",
        "children": [
          {
            "type": "party",
            "role": "issuer",
            "label": "De",
            "labelStyle": {
              "size": 6.75,
              "weight": 700,
              "uppercase": true,
              "letterSpacing": 0.75,
              "color": "gold",
              "marginBottom": 3.75
            },
            "nameStyle": {
              "size": 9,
              "weight": 700
            },
            "style": {
              "flex": 1,
              "size": 7.5,
              "gap": 1.5
            }
          },
          {
            "type": "party",
            "role": "customer",
            "label": "Para",
            "labelStyle": {
              "size": 6.75,
              "weight": 700,
              "uppercase": true,
              "letterSpacing": 0.75,
              "color": "gold",
              "marginBottom": 3.75
            },
            "nameStyle": {
              "size": 9,
              "weight": 700
            },
            "style": {
              "flex": 1,
              "size": 7.5,
              "gap": 1.5
            }
          }
        ],
        "style": {
          "marginBottom": 19.5,
          "gap": 22.5
        }
      },
      {
        "type": "items",
        "headerStyle": {
          "size": 6.75,
          "weight": 700,
          "uppercase": true,
          "letterSpacing": 0.45,
          "color": "muted",
          "paddingY": 6,
          "borderBottom": {
            "width": 1.5,
            "color": "ink"
          }
        },
        "rowStyle": {
          "paddingY": 6.75,
          "borderBottom": {
            "width": 0.563,
            "color": "line"
          }
        },
        "detailsStyle": {
          "size": 7.125,
          "color": "muted",
          "marginTop": 1.5
        },
        "style": {
          "size": 7.5
        }
      },
      {
        "type": "row",
        "children": [
          {
            "type": "stack",
            "children": [
              {
                "type": "amountInWords",
                "labelStyle": {
                  "size": 6.75,
                  "weight": 700,
                  "uppercase": true,
                  "letterSpacing": 0.75,
                  "color": "gold",
                  "marginBottom": 3.75
                },
                "style": {
                  "size": 7.5
                }
              },
              {
                "type": "notes",
                "labelStyle": {
                  "size": 6.75,
                  "weight": 700,
                  "uppercase": true,
                  "letterSpacing": 0.75,
                  "color": "gold",
                  "marginBottom": 3.75
                },
                "style": {
                  "size": 7.5,
                  "color": "muted"
                }
              },
              {
                "type": "payment",
                "labelStyle": {
                  "size": 6.75,
                  "weight": 700,
                  "uppercase": true,
                  "letterSpacing": 0.75,
                  "color": "gold",
                  "marginBottom": 3.75
                },
                "style": {
                  "size": 7.5
                }
              },
              {
                "type": "bank",
                "labelStyle": {
                  "size": 6.75,
                  "weight": 700,
                  "uppercase": true,
                  "letterSpacing": 0.75,
                  "color": "gold",
                  "marginBottom": 3.75
                },
                "style": {
                  "size": 7.5
                }
              }
            ],
            "style": {
              "gap": 9,
              "flex": 1
            }
          },
          {
            "type": "totals",
            "titleStyle": {
              "size": 6.75,
              "weight": 700,
              "uppercase": true,
              "letterSpacing": 0.75,
              "color": "gold",
              "marginBottom": 3.75
            },
            "totalStyle": {
              "font": "display",
              "size": 15,
              "weight": 700
            },
            "style": {
              "flex": 1,
              "size": 7.5,
              "background": "soft",
              "padding": 13.5
            }
          }
        ],
        "style": {
          "marginTop": 18,
          "gap": 25.5,
          "alignItems": "start"
        }
      },
      {
        "type": "fiscal",
        "style": {
          "size": 7.125,
          "lineHeight": 1.35,
          "color": "muted",
          "marginTop": 16.5,
          "gap": 2.25
        }
      }
    ],
    "top": {
      "style": {
        "background": "ink",
        "paddingX": 40.5,
        "paddingY": 22.5,
        "borderBottom": {
          "width": 3,
          "color": "gold"
        }
      },
      "children": [
        {
          "type": "row",
          "children": [
            {
              "type": "stack",
              "children": [
                {
                  "type": "documentTitle",
                  "style": {
                    "font": "display",
                    "size": 22.5,
                    "color": "#FFFFFF"
                  }
                },
                {
                  "type": "documentNumber",
                  "style": {
                    "size": 9,
                    "color": "#D4D4D8"
                  }
                }
              ],
              "style": {
                "gap": 3
              }
            },
            {
              "type": "stack",
              "children": [
                {
                  "type": "logo",
                  "height": 31.5,
                  "fallbackStyle": {
                    "font": "display",
                    "size": 15,
                    "color": "gold"
                  }
                },
                {
                  "type": "documentDate",
                  "style": {
                    "size": 7.875,
                    "color": "#D4D4D8"
                  }
                },
                {
                  "type": "copyLabel",
                  "style": {
                    "size": 6.75,
                    "weight": 700,
                    "uppercase": true,
                    "letterSpacing": 1.125,
                    "color": "gold"
                  }
                }
              ],
              "style": {
                "gap": 3,
                "alignItems": "end"
              }
            }
          ],
          "style": {
            "alignItems": "center",
            "justify": "between"
          }
        }
      ]
    },
    "bottom": {
      "height": 28.5,
      "style": {
        "background": "ink",
        "paddingX": 40.5,
        "justify": "center"
      },
      "children": [
        {
          "type": "row",
          "children": [
            {
              "type": "text",
              "text": "{{org.name}} · {{org.website}}",
              "style": {
                "size": 7.125,
                "color": "#D4D4D8"
              }
            },
            {
              "type": "pageNumber",
              "style": {
                "size": 7.125,
                "weight": 700,
                "color": "gold"
              }
            }
          ],
          "style": {
            "justify": "between"
          }
        }
      ]
    }
  }
}
